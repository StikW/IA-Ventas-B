# =============================================================================
# IA Ventas — Variables de entorno
# Copia este archivo: cp .env.example .env
# =============================================================================

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# REQUERIDO AHORA (Fase 0 + 1 — Auth, Negocios, Usuarios)
# -----------------------------------------------------------------------------

# JWT — genera valores aleatorios de al menos 32 caracteres:
#   npm run secrets:generate
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# DynamoDB local (dynalite) — NO requiere credenciales AWS
# Terminal 1: npm run dynamodb:start
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_NAME=PlatformTable
DYNAMODB_AUDIT_TABLE_NAME=AuditLogTable

# Frontend
CORS_ORIGIN=http://localhost:4200

# Usuario admin inicial (solo desarrollo — npm run seed)
SEED_ADMIN_EMAIL=admin@iaventas.com
SEED_ADMIN_PASSWORD=Admin123!

# -----------------------------------------------------------------------------
# FASE 2 — Email / recuperación de contraseña (opcional en local)
# Sin configurar: el reset de contraseña no enviará emails
# -----------------------------------------------------------------------------
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@iaventas.com

# -----------------------------------------------------------------------------
# FASE 3 — Documentos, RAG, IA (cuando implementemos Knowledge + AI)
# -----------------------------------------------------------------------------

# OpenAI — https://platform.openai.com/api-keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Pinecone — https://app.pinecone.io/
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX=platform-knowledge
# PINECONE_HOST=https://your-index-xxxx.svc.region.pinecone.io

# Amazon S3 — solo si subes documentos a AWS (no necesario en local inicial)
# Dejar vacío en local; más adelante usaremos S3 real o emulador local (MinIO)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=platform-storage-dev

# -----------------------------------------------------------------------------
# FASE 4 — BuilderBot WhatsApp
#
# Flujo app.builderbot.cloud (key bbc-..., deploy + QR por manager API):
#
#   BUILDERBOT_API_MODE=cloud-v2
#   BUILDERBOT_API_URL=https://app.builderbot.cloud/api/v1/manager
#   BUILDERBOT_API_KEY=bbc-...   ← desde app.builderbot.cloud
#
# Flujo alternativo console.builderbot.app (wa-api, device + QR directo):
#
#   BUILDERBOT_API_MODE=wa-api
#   BUILDERBOT_API_URL=https://wa-api.builderbot.app/v1
#   BUILDERBOT_API_KEY=...       ← desde https://console.builderbot.app/apikeys
# -----------------------------------------------------------------------------
BUILDERBOT_API_MODE=cloud-v2
BUILDERBOT_API_URL=https://app.builderbot.cloud/api/v1/manager
BUILDERBOT_API_KEY=
# Opcional: proteger POST /webhooks/builderbot/:tenantId
# BUILDERBOT_WEBHOOK_SECRET=
# Opcional: verificación GET hub.verify_token (WhatsApp Cloud API style)
# BUILDERBOT_WEBHOOK_VERIFY_TOKEN=
APP_PUBLIC_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# PRODUCCIÓN — ventas.nedi.info
# Ver también backend/.env.production.example
#   APP_PUBLIC_URL=https://ventas.nedi.info
#   CORS_ORIGIN=https://ventas.nedi.info
# Webhook BuilderBot (auto por negocio):
#   https://ventas.nedi.info/api/v1/webhooks/builderbot/{tenantId}
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# FASE 5 — WooCommerce (credenciales por negocio en panel, no en .env global)
# Consumer Key + Consumer Secret se guardan por tenant en Secrets Manager / DB
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# PRODUCCIÓN — DynamoDB y AWS reales (cuando despliegues en AWS)
# Quita DYNAMODB_ENDPOINT para usar DynamoDB managed
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
