# IA Ventas — producción (ventas.nedi.info)
# Copia al servidor como backend/.env y completa los secretos reales.

NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# DynamoDB AWS (sin DYNAMODB_ENDPOINT)
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_NAME=PlatformTable
DYNAMODB_AUDIT_TABLE_NAME=AuditLogTable

APP_PUBLIC_URL=https://ventas.nedi.info
CORS_ORIGIN=https://ventas.nedi.info

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# No definir OPENAI_BASE_URL vacío; el backend usa https://api.openai.com/v1
PINECONE_API_KEY=
PINECONE_INDEX=platform-knowledge

BUILDERBOT_API_MODE=cloud-v2
BUILDERBOT_API_URL=https://app.builderbot.cloud/api/v1/manager
BUILDERBOT_API_KEY=
